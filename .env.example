# Email Configuration for Nodemailer (Vercel Deployment)
# Add these as Environment Variables in Vercel Dashboard

# Email service provider (gmail, outlook, etc.)
EMAIL_SERVICE=gmail

# Your email address (used to send emails)
EMAIL_USER=gunmatrixshootingacademy@gmail.com

# Your email password or app password
# For Gmail: Use App Password (not regular password)
# Go to: Google Account > Security > 2-Step Verification > App passwords
EMAIL_PASS=your-app-password-here

# Email address to receive inquiries (defaults to EMAIL_USER if not set)
RECEIVER_EMAIL=gunmatrixshootingacademy@gmail.com
